---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PracticeDeskIsland } from '../components/home/PracticeDeskIsland';
---

<BaseLayout title="The Cozy Strum — Personal Guitar & Ukulele Sanctuary">
  <!-- Hero Section -->
  <div class="mb-8 text-center max-w-2xl mx-auto space-y-2 px-2 sm:px-0">
    <div class="inline-flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 px-3 py-1 rounded-full bg-surface border border-warm text-[11px] sm:text-xs font-mono text-terracotta mb-2 shadow-2xs">
      <span class="whitespace-nowrap">✦ No Ads</span>
      <span class="text-warm/80" aria-hidden="true">•</span>
      <span class="whitespace-nowrap">No Subscriptions</span>
      <span class="text-warm/80" aria-hidden="true">•</span>
      <span class="whitespace-nowrap">Zero Distractions</span>
    </div>
    <h1 class="font-serif text-2xl sm:text-4xl md:text-5xl font-bold text-espresso tracking-tight [text-wrap:balance]">
      Your Acoustic Sanctuary
    </h1>
    <p class="text-xs sm:text-base text-walnut leading-relaxed max-w-xl mx-auto">
      A quiet practice desk for string players. Instant search across 243+ songs, local practice history, auto-scroll, and dynamic chord diagrams.
    </p>
  </div>

  <!-- Zero-Read Personal Practice Desk -->
  <PracticeDeskIsland client:load />
</BaseLayout>
