---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LibraryIsland } from '../components/library/LibraryIsland';
import type { TabItem } from '../lib/types';

// Initial tabs for SSR shell (hydrates and updates from Firestore catalog cache on client:load)
const initialTabs: TabItem[] = [];
---

<BaseLayout title="The Cozy Strum — Personal Guitar & Ukulele Sanctuary">
  <!-- Hero Section -->
  <div class="mb-10 text-center max-w-2xl mx-auto space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-warm text-xs font-mono text-terracotta mb-2">
      <span>✦ No Ads</span>
      <span>•</span>
      <span>No Subscriptions</span>
      <span>•</span>
      <span>100% Database Catalog</span>
    </div>
    <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-espresso tracking-tight [text-wrap:balance]">
      Your Acoustic Sanctuary
    </h1>
    <p class="text-sm sm:text-base text-walnut leading-relaxed">
      Clean, instant, distraction-free guitar and ukulele tabs with dynamic SVG chord diagrams, smooth auto-scroll, and stage view.
    </p>
  </div>

  <!-- Interactive Library Island -->
  <LibraryIsland client:load initialTabs={initialTabs} />
</BaseLayout>
