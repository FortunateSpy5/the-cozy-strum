---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TabPlayerIsland } from '../../components/player/TabPlayerIsland';

export async function getStaticPaths() {
  const tabs = await getCollection('tabs');
  return tabs.map((tab) => ({
    params: { slug: tab.slug },
    props: { tab }
  }));
}

interface Props {
  tab: CollectionEntry<'tabs'>;
}

const { tab } = Astro.props;
---

<BaseLayout
  title={`${tab.data.title} (${tab.data.artist}) — The Cozy Strum`}
  description={`Ad-free chords & ASCII tablature for ${tab.data.title} by ${tab.data.artist}.`}
>
  <TabPlayerIsland
    client:load
    metadata={{
      title: tab.data.title,
      artist: tab.data.artist,
      instrument: tab.data.instrument,
      tuning: tab.data.tuning,
      capo: tab.data.capo,
      bpm: tab.data.bpm,
      difficulty: tab.data.difficulty,
      strummingPattern: tab.data.strummingPattern,
      tags: tab.data.tags,
      isFingerstyle: tab.data.isFingerstyle,
      key: tab.data.key,
      createdAt: tab.data.createdAt
    }}
    rawTabContent={tab.body}
  />
</BaseLayout>
