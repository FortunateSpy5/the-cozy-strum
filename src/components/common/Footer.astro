<footer class="w-full border-t border-warm bg-surface/50 mt-16 pt-10 pb-40 sm:pb-44 text-xs text-walnut transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex flex-col gap-1">
        <p class="font-serif text-sm font-semibold text-espresso">
          The Cozy Strum — Pure Acoustic Sanctuary
        </p>
        <p class="text-walnut">
          No subscription walls, no auto-playing ads, zero tracking. 100% static Astro 5 & React.
        </p>
      </div>

      <!-- Navigation & Legal Links -->
      <nav aria-label="Footer Navigation" class="flex flex-wrap items-center justify-center gap-1 sm:gap-2">
        <a
          href="/"
          class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded-md text-walnut hover:text-terracotta hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta transition-colors"
        >
          Desk
        </a>
        <span class="text-warm" aria-hidden="true">•</span>
        <a
          href="/explore"
          class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded-md text-walnut hover:text-terracotta hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta transition-colors"
