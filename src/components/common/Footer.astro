          Song Directory
        </a>
        <span class="text-warm" aria-hidden="true">•</span>
        <a
          href="/setlists"
          class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded-md text-walnut hover:text-terracotta hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta transition-colors"
        >
          Setlists
        </a>
        <span class="text-warm" aria-hidden="true">•</span>
        <a
          href="/submit"
          class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded-md text-walnut hover:text-terracotta hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta transition-colors"
