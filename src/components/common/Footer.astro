        <a
          href="https://github.com/FortunateSpy5/the-cozy-skillet"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded-md bg-canvas border border-warm hover:border-terracotta hover:text-espresso focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta transition-colors"
