# Firebase Web Configuration for The Cozy Strum
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey123456789
PUBLIC_FIREBASE_AUTH_DOMAIN=the-cozy-strum.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=the-cozy-strum
PUBLIC_FIREBASE_STORAGE_BUCKET=the-cozy-strum.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# Admin Role Bootstrapping
# Users signing in with this email are automatically granted role: 'admin'
PUBLIC_SUPERADMIN_EMAIL=your-google-email@gmail.com
