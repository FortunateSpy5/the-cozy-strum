rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Catalog Index: Publicly readable by all; writable only by Admins
    match /meta/catalog_index {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Read/Write own profile; prevent users from escalating their own role to 'admin'
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && (
        request.resource.data.role == 'user' ||
        (request.resource.data.role == 'admin' && request.auth.token.email.lower() == 'msoumen555@gmail.com')
      );
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
    }

    // Tabs:
    // - Anyone can read 'public' + 'approved' tabs
    // - Authors can read/write their own 'private', 'draft', or 'pending_review' tabs
    // - Admins can read/write/moderate all tabs
    match /tabs/{tabId} {
      allow read: if (resource.data.visibility == 'public' && resource.data.status == 'approved')
                  || (isSignedIn() && resource.data.authorUid == request.auth.uid)
                  || isAdmin();
      allow create: if isSignedIn() 
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status in ['draft', 'pending_review']
                    && request.resource.data.favoritesCount == 0
                    && request.resource.data.viewsCount == 0
                    && request.resource.data.title is string && request.resource.data.title.size() <= 200
                    && request.resource.data.artist is string && request.resource.data.artist.size() <= 200
                    && request.resource.data.content is string && request.resource.data.content.size() <= 65536;
      allow update: if (isSignedIn() && resource.data.authorUid == request.auth.uid 
                        && resource.data.status != 'approved'
                        && resource.data.status != 'removed_dmca'
                        && request.resource.data.authorUid == resource.data.authorUid
                        && request.resource.data.status in ['draft', 'pending_review']
                        && request.resource.data.title is string && request.resource.data.title.size() <= 200
                        && request.resource.data.artist is string && request.resource.data.artist.size() <= 200
                        && request.resource.data.content is string && request.resource.data.content.size() <= 65536)
                    || isAdmin();
      allow delete: if (isSignedIn() && resource.data.authorUid == request.auth.uid 
                        && resource.data.status != 'approved'
                        && resource.data.status != 'removed_dmca') 
                    || isAdmin();
    }

    // Setlists: Public setlists readable by all; private only by owner
    match /setlists/{setlistId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.ownerUid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isOwner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid) || isAdmin();
      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // DMCA Requests: Anyone can submit (create); only Admins can read or resolve
    match /dmca_requests/{requestId} {
      allow create: if request.resource.data.status == 'open'
                    && request.resource.data.statementOfGoodFaith == true
                    && request.resource.data.claimantName is string && request.resource.data.claimantName.size() <= 200
                    && request.resource.data.claimantEmail is string && request.resource.data.claimantEmail.size() <= 200
                    && request.resource.data.songTitle is string && request.resource.data.songTitle.size() <= 200
                    && request.resource.data.digitalSignature is string && request.resource.data.digitalSignature.size() <= 200
                    && request.resource.data.infringingUrl is string && request.resource.data.infringingUrl.size() <= 500;
      allow read, update, delete: if isAdmin();
    }
  }
}
